  "transformations": [
    "Replace top-level Tailwind v4 @theme blocks with .aurora-root without changing declarations; add aurora-root to the application or requested surface wrapper.",
    "Provide plain CSS imports; omit Tailwind, remote fonts, app body resets, feature pages and handbook skins.",
    "Add scoped box-sizing:border-box compatibility for CTA/twins/card utilities previously relying on Tailwind preflight.",
    "Require aurora-bg-global class for body/root background pseudo-elements; explicit aurora-bg children use absolute position inside their container.",
    "Remove legacy card blur utility aliases; scope white theme declarations to an Aurora root or its descendant.",
    "Restore existing disabled-primary token values after theme/twins gradient selectors; fix selector specificity without changing the token values.",
    "Dark primary/twins CTA labels use solid Aurora pink #FF3278. White-theme gradient labels use solid white and focus uses Aurora ink; preserve upstream source hashes, brand gradient/fills and geometry. Native controls use the same primary-label adaptation while raw Figma source visual scenes remain unchanged. Disabled states remain exempt.",
    "User preference: dark primary CTA labels use solid Aurora pink #FF3278 without text gradients; white-theme and disabled treatments remain separate.",
    "2026-11-07 user-approved light theme: halve decorative Aurora cloud/mesh/art alpha; use pure-white card fills with independent alpha (default 60%, raised/popups 80%); gradient-filled CTA labels are solid white. Original source theme evidence remains unchanged."
  ],
  "coverage": [
    "tokens",
    "cta-css-utilities",
    "card-css-utility",
    "aurora-background-css",
    "white-theme-overrides",
    "prebuilt-react-library"
  ],
  "limitations": [
    "Code/Figma Primary mismatch; see source contract",
    "No complete state/theme or accessibility certification",
    "The plain CSS adapter alone covers the core token/CTA/card/background subset; React coverage is recorded separately in libraries.react.",
    "React includes native controls plus static source compositions; complete product workflows, all behaviors, all themes and accessibility are not certified.",
    "Local licensed Inter font faces are included for React; other source font families may require licensed font assets or the glyph rendering option.",
    "Static Figma source-screen render exports are excluded from this lightweight profile. Use catalog entries marked compiled-export; source-metadata-only entries require implementation from the linked Aurora source."
  ],
